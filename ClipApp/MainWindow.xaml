<Window x:Class="ClipApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlotPaste" Height="460" Width="520" Icon="/SlotPaste.ico" Topmost="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- вид кнопок, полей, списков, вкладок и меню теперь общий для всех окон и лежит в Theme.cs -->

        <!-- меню «вставить как…» (правый клик по записи или Shift+Enter).
             В Tag лежит короткое имя преобразования, его понимает TextTools.Apply -->
        <ContextMenu x:Key="TransformMenu">
            <MenuItem Header="Вставить как обычный текст" Tag="plain" Click="Transform_Click"/>
            <Separator/>
            <MenuItem Header="ВЕРХНИЙ РЕГИСТР" Tag="upper" Click="Transform_Click"/>
            <MenuItem Header="нижний регистр" Tag="lower" Click="Transform_Click"/>
            <MenuItem Header="Каждое Слово С Заглавной" Tag="title" Click="Transform_Click"/>
            <Separator/>
            <MenuItem Header="Без лишних пробелов" Tag="clean" Click="Transform_Click"/>
            <MenuItem Header="В одну строку" Tag="oneline" Click="Transform_Click"/>
            <MenuItem Header="Исправить раскладку (ghbdtn → привет)" Tag="layout" Click="Transform_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel Margin="12,8,12,12">
        <!-- строка состояния внизу: видна, только когда включена очередь или пауза -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,8,0,0" FontWeight="SemiBold"
                   Foreground="{DynamicResource Warning}" Visibility="Collapsed" TextWrapping="Wrap"/>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- Вкладка 1: всё, что копировал -->
            <TabItem Header="История">
                <DockPanel>
                    <!-- поле поиска сверху; серая подсказка лежит поверх поля и прячется, когда начинаешь печатать -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <TextBlock x:Name="SearchHint" Text="Поиск…" Foreground="{DynamicResource SubtleText}" Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <!-- низ вкладки: подсказка слева, кнопка справа -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Очистить историю" Margin="8,0,0,0"
                                Focusable="False" Click="ClearHistory_Click"/>
                        <TextBlock Text="Правый клик или Shift+Enter: вставить с преобразованием"
                                   Foreground="{DynamicResource SubtleText}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <!-- SelectionMode="Extended": можно выделять несколько строк (Ctrl/Shift + клик, Shift + стрелки, Ctrl+A) -->
                    <ListBox x:Name="HistoryList"
                             SelectionMode="Extended"
                             MouseDoubleClick="List_MouseDoubleClick"
                             ContextMenu="{StaticResource TransformMenu}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Вкладка 2: закреплённые записи, не вытесняются и не стираются вместе с историей -->
            <TabItem Header="Закреплённые">
                <DockPanel>
                    <!-- текст подсказки подставляется из кода под текущее сочетание -->
                    <TextBlock x:Name="PinnedHint" DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="{DynamicResource SubtleText}" TextWrapping="Wrap"/>
                    <ListBox x:Name="PinnedList"
                             SelectionMode="Extended"
                             MouseDoubleClick="List_MouseDoubleClick"
                             ContextMenu="{StaticResource TransformMenu}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Вкладка 3: ячейки 1–9 из выбранного набора -->
            <TabItem Header="Ячейки">
                <DockPanel>
                    <!-- выбор набора и кнопки; Focusable="False", чтобы Enter и Delete продолжали работать со списком -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Набор:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="SetBox" Width="130" Focusable="False" SelectionChanged="SetBox_SelectionChanged"/>
                        <Button Content="Добавить" Padding="10,4" Margin="6,0,0,0" Focusable="False" Click="AddSet_Click"/>
                        <Button Content="Переименовать" Padding="10,4" Margin="6,0,0,0" Focusable="False" Click="RenameSet_Click"/>
                        <Button Content="Удалить" Padding="10,4" Margin="6,0,0,0" Focusable="False" Click="DeleteSet_Click"/>
                    </StackPanel>
                    <!-- текст подсказки подставляется из кода под текущие хоткеи -->
                    <TextBlock x:Name="SlotsHint" DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="{DynamicResource SubtleText}" TextWrapping="Wrap"/>
                    <ListBox x:Name="SlotsList"
                             MouseDoubleClick="List_MouseDoubleClick"
                             ContextMenu="{StaticResource TransformMenu}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
                                    <TextBlock x:Name="PreviewText" Grid.Column="1" Text="{Binding Preview}"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- пустые ячейки рисуем серым курсивом -->
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter TargetName="PreviewText" Property="Foreground" Value="{DynamicResource SubtleText}"/>
                                        <Setter TargetName="PreviewText" Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <!-- но если строка выбрана (синяя), текст белый, чтобы читался -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="PreviewText" Property="Foreground" Value="{DynamicResource SelectionText}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

<Application x:Class="SlotPaste.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SlotPaste"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Черновые цвета (как в тёмной теме) — ТОЛЬКО для конструктора Visual Studio,
                     чтобы он не ругался «Не удалось разрешить ресурс WindowBg» и показывал окна похоже.
                     При запуске программы Theme.cs убирает этот словарь и ставит настоящие цвета и стили.
                     Если добавляешь новый цвет в Theme.cs (BuildColors), добавь его и сюда с тем же именем. -->
                <ResourceDictionary>
                    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
                    <SolidColorBrush x:Key="PanelBg" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="InputBg" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="ControlBg" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="ControlHoverBg" Color="#383838"/>
                    <SolidColorBrush x:Key="ControlPressedBg" Color="#262626"/>
                    <SolidColorBrush x:Key="Border" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="BorderHover" Color="#525252"/>
                    <SolidColorBrush x:Key="Text" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="SubtleText" Color="#B4B4B4"/>
                    <SolidColorBrush x:Key="Accent" Color="#0078D7"/>
                    <SolidColorBrush x:Key="AccentHover" Color="#1A86DD"/>
                    <SolidColorBrush x:Key="AccentPressed" Color="#006CC1"/>
                    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SelectionBg" Color="#0078D7"/>
                    <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="HoverBg" Color="#353535"/>
                    <SolidColorBrush x:Key="MenuBg" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="Separator" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="ScrollThumb" Color="#5C5C5C"/>
                    <SolidColorBrush x:Key="ScrollThumbHover" Color="#808080"/>
                    <SolidColorBrush x:Key="Error" Color="#FF99A4"/>
                    <SolidColorBrush x:Key="Warning" Color="#FFB86B"/>

                    <!-- синяя кнопка: в программе её заменит полный стиль из Theme.cs -->
                    <Style x:Key="AccentButton" TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

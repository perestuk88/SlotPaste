<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль публикации «Portable»: собирает SlotPaste.exe одним файлом,
  который запускается на любом Windows 10/11 x64 без установки .NET.
  В Visual Studio: правый клик по проекту → Опубликовать → профиль Portable → Опубликовать.
  Готовый exe появится в папке bin\Release\net10.0-windows\win-x64\publish\
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- .NET кладём внутрь exe: у пользователя ничего ставить не нужно -->
    <SelfContained>true</SelfContained>
    <!-- всё в один файл SlotPaste.exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- нативные библиотеки WPF тоже внутрь exe (при запуске они распаковываются сами) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- сжатие: exe меньше, запуск на долю секунды дольше -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- без .pdb-файлов отладки рядом с exe -->
    <DebugType>none</DebugType>
    <!-- переводы сообщений .NET на другие языки не нужны: exe меньше -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- ВАЖНО: PublishTrimmed (обрезку) для WPF включать нельзя, программа сломается -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
